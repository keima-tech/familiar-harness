{
  "name": "familiar-harness",
  "description": "Familiar Harness - a local-first client/server agent harness with CLI, Web UI and Desktop frontends",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/keima-tech/familiar-harness.git"
  },
  "homepage": "https://github.com/keima-tech/familiar-harness",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -b .",
    "clean": "node scripts/clean-dist.mjs",
    "typecheck": "tsc -b . --force",
    "dev:cli": "node packages/cli/dist/familiar.js",
    "smoke": "npm run -w packages/cli smoke",
    "mdtest": "node packages/server/scripts/md-test.mjs",
    "serve": "npm run -w packages/cli serve",
    "version:set": "node scripts/set-version.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "typescript": "^5.8.0",
    "ws": "^8.18.0"
  },
  "version": "0.1.0"
}
