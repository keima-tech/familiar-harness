{
  "name": "@familiar/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Familiar desktop shell (Electron) — client for familiar-server; packaged via electron-builder (M6)",
  "main": "main.js",
  "desktopName": "familiar-harness.desktop",
  "author": "Familiar contributors",
  "homepage": "https://github.com/keima-tech/familiar-harness",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "stage": "node scripts/stage.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:ssh": "node scripts/ssh-e2e.mjs",
    "pack:linux": "npm run stage && electron-builder --linux deb AppImage",
    "pack:win": "npm run stage && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "dev.familiar.harness",
    "productName": "Familiar Harness",
    "directories": {
      "output": "release"
    },
    "artifactName": "familiar-${version}-${os}-${arch}.${ext}",
    "electronLanguages": [
      "en",
      "ja"
    ],
    "compression": "maximum",
    "files": [
      "main.js",
      "preload.js",
      "ssh.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "stage/familiar/packages",
        "to": "familiar/packages",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "stage/familiar/node_modules",
        "to": "familiar/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "familiar-${version}-${os}-${arch}-portable.${ext}"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Development",
      "executableName": "familiar",
      "maintainer": "Familiar contributors <familiar@example.invalid>",
      "syncDesktopName": true
    }
  }
}
